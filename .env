# ======================
# DATABASE
# ======================
DB_HOST=postgres
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SCHEMA=did

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ======================
# REDIS
# ======================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ======================
# SMTP
# ======================
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_PASSWORD=

# ======================
# MINIO
# ======================
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BROWSER_REDIRECT_URL=

# ======================
# COMMON KEYS
# ======================
AI_SERVICE_API_KEY=
AIPOLICY_API_KEY=

# The two keys below are pre-set for this deployment. Do NOT change them once
# the stack has run: both encrypt data at rest, and changing a key does not
# fail loudly -- it silently makes existing data unreadable (and locks every
# user out of MFA for the TOTP key). Keep a backup of this file.

# REQUIRED. entra-service refuses to start without it; ad-service needs it for
# credential encryption. 32 chars:  openssl rand -hex 16
ENCRYPTION_KEY=52747ba323dfeccb203fbde2ce6f88e4

# REQUIRED if MFA/TOTP is used. Changing it invalidates every enrolled TOTP
# secret, locking users out of MFA. 64 hex chars:  openssl rand -hex 32
TOTP_ENCRYPTION_KEY=99ead1f5ff479047de583d79bb6873bd1c08c7593a7ccbaa11f5c9b0c5d531da

LOCAL_PASSWORD=
IPINFO_TOKEN=
AZURE_OPENAI_API_KEY=
GIT_TOKEN=

# ======================
# TWILIO
# ======================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# ======================
# AWS
# ======================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# ======================
# CLOUDFLARE
# ======================
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_AUTH_KEY=
CLOUDFLARE_AUTH_EMAIL=

# ======================
# AZURE
# ======================
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
# ======================
# ONPREM UI CONFIG
TENANT_ID=1
ORG_NAME=
DOMAIN_URL=
SYSTEM_URL=
SYSTEM_IP=
# ======================

# ======================
# REDIS / DB TUNING
# ======================
# Referenced by ad-service, policy-service, dbconsole-service, entra-service.
REDIS_DB=0

# ======================
# HOST PORT OVERRIDES
# ======================
# Change if the default collides with something already on the host.
# 9090 is used by cockpit on many RHEL/Debian installs.
PAM_HOST_PORT=9090

# ======================
# OKTA SSO (OPTIONAL)
# ======================
# Only needed if you run:  docker compose --profile okta up -d
# Both values come from YOUR Okta tenant, not from AuthNull:
#   Okta Admin -> Applications -> <your SAML app> -> Sign On
#   ROOT_URL          = the SAML Audience URI / entity ID
#   IDP_METADATA_URL  = the "Identity Provider metadata" link
OKTA_LOGIN_ROOT_URL=
OKTA_LOGIN_IDP_METADATA_URL=

# Optional: Okta SSO URL for blockchain-ipfs-logging.
BLOCKCHAIN_OKTA_APP_SSO_URL=

# ======================
# OPTIONAL INTEGRATIONS
# ======================
# Ethereum RPC for verifier-service. Leave blank to disable on-chain lookups.
ALCHEMY_API_KEY=

# Google Cloud bucket for pam-service session recordings (optional --
# pam-service also supports LOCAL_STORAGE_ENABLED=true).
GCLOUD_BUCKET_NAME=

# Kafka audit-log sink for authn-service. Leave blank to disable.
KAFKA_BROKERS=
KAFKA_TOPIC=

COMPOSE_PROJECT_NAME=onprem
